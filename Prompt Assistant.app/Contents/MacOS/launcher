#!/bin/bash
# Prompt Assistant 应用启动器：找到同级的 run.command 并交给它处理全部启动逻辑。
# 本 .app 默认放在项目根目录，与 run.command 同级；若需移动 .app，请一并移动项目目录，
# 或把 run.command 放在与 .app 相同的目录。
APP_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
RUN="$APP_DIR/../run.command"
if [ ! -f "$RUN" ]; then
  # 兼容：run.command 就放在 .app 同级目录
  RUN="$(dirname "$APP_DIR")/run.command"
fi
if [ ! -f "$RUN" ]; then
  osascript -e 'display dialog "找不到 run.command，请确认 Prompt Assistant.app 与项目文件放在一起。" buttons {"好"} default button "好" icon caution' >/dev/null 2>&1
  exit 1
fi
chmod +x "$RUN" 2>/dev/null
exec "$RUN" "$@"
